// Helper functions
function extractTimeSeries(charts) {
  const entries = Object.entries(charts);
  return entries.map(([_, value]) => parseFloat(value) || 0);
}

function calculateConfidenceIntervals(historical, forecast) {
  const historicalStd = calculateStdDev(historical);
  return forecast.map(value => ({
    lower: value - 1.96 * historicalStd,
    upper: value + 1.96 * historicalStd
  }));
}

function calculateStdDev(values) {
  const mean = values.reduce((a, b) => a + b, 0) / values.length;
  const variance = values.reduce((sum, x) => sum + Math.pow(x - mean, 2), 0) / values.length;
  return Math.sqrt(variance);
}

function calculateForecastMetrics(timeSeries) {
  const mean = timeSeries.reduce((a, b) => a + b, 0) / timeSeries.length;
  const trend = (timeSeries[timeSeries.length - 1] - timeSeries[0]) / timeSeries.length;
  
  return {
    mean,
    trend,
    volatility: calculateStdDev(timeSeries) / mean,
    growth: ((timeSeries[timeSeries.length - 1] - timeSeries[0]) / timeSeries[0]) * 100
  };
}

