// Time series forecasting endpoint
router.post("/forecast", 
  upload.single("file"), 
  validateCSVUpload,
  cacheMiddleware(req => `forecast:${req.file.filename}`, 600000),
  async (req, res) => {
    try {
      const data = await processCSV(req.file.path);
      const { method = 'arima', steps = 12, seasonalPeriod = 12 } = req.body;
      
      // Extract time series from data
      const timeSeries = extractTimeSeries(data.charts);
      
      let forecast;
      
      if (method === 'arima') {
        const arima = new ARIMAPredictor(2, 1, 2);
        arima.fit(timeSeries);
        forecast = arima.forecast(parseInt(steps));
      } else if (method === 'exponential') {
        const es = new ExponentialSmoothing(0.3, 0.1, 0.1);
        es.holtWinters(timeSeries, parseInt(seasonalPeriod));
        forecast = es.forecast(parseInt(steps));
      } else {
        // Default linear regression
        const x = timeSeries.map((_, idx) => idx);
        const model = linearRegression(x, timeSeries);
        forecast = Array(parseInt(steps)).fill(0).map((_, idx) => 
          model.slope * (timeSeries.length + idx) + model.intercept
        );
      }
      
      res.json({
        historical: timeSeries,
        forecast,
        method,
        confidence: calculateConfidenceIntervals(timeSeries, forecast),
        metrics: calculateForecastMetrics(timeSeries)
      });
    } catch (error) {
      res.status(500).json({ error: error.message });
    }
  }
);

// Customer segmentation endpoint
router.post("/segment-customers",
  upload.single("file"),
  validateCSVUpload,
  async (req, res) => {
    try {
      const rawData = await processCSV(req.file.path);
      const { clusters = 3 } = req.body;
      
      // Prepare customer features
      const customerFeatures = prepareCustomerFeatures(rawData);
      
      // Normalize features
      const normalized = normalizeFeatures(customerFeatures.features);
      
      // Perform clustering
      const kmeans = new KMeansClustering(parseInt(clusters), 100);
      kmeans.fit(normalized);
      
      // Assign cluster labels to customers
      const segmentedCustomers = customerFeatures.customers.map((customer, idx) => ({
        ...customer,
        segment: kmeans.labels[idx],
        segmentName: getSegmentName(kmeans.labels[idx], kmeans.centroids[kmeans.labels[idx]])
      }));
      
      // Calculate segment statistics
      const segmentStats = calculateSegmentStats(segmentedCustomers, kmeans);
      
      res.json({
        customers: segmentedCustomers,
        segments: segmentStats,
        clusterCenters: kmeans.centroids,
        totalClusters: clusters
      });
    } catch (error) {
      res.status(500).json({ error: error.message });
    }
  }
);

// Anomaly detection endpoint
router.post("/detect-anomalies",
  upload.single("file"),
  validateCSVUpload,
  async (req, res) => {
    try {
      const data = await processCSV(req.file.path);
      const { method = 'zscore', threshold = 3 } = req.body;
      
      // Extract revenue time series
      const timeSeries = extractTimeSeries(data.charts);
      
      // Detect anomalies
      const detector = new AnomalyDetector(method, parseFloat(threshold));
      detector.fit(timeSeries);
      
      const anomalies = detector.detectBatch(timeSeries);
      
      // Find anomalous points
      const anomalousPoints = anomalies
        .map((result, idx) => ({
          index: idx,
          value: timeSeries[idx],
          ...result
        }))
        .filter(point => point.isAnomaly);
      
      res.json({
        timeSeries,
        anomalies: anomalousPoints,
        totalAnomalies: anomalousPoints.length,
        anomalyRate: (anomalousPoints.length / timeSeries.length) * 100,
        detectorStats: {
          mean: detector.mean,
          stdDev: detector.stdDev,
          q1: detector.q1,
          q3: detector.q3,
          iqr: detector.iqr
        }
      });
    } catch (error) {
      res.status(500).json({ error: error.message });
    }
  }
);

