backend/routes/analytics.js
const express = require("express");
const multer = require("multer");
const processCSV = require("../utils/csvProcessor");
const predictProduct = require("../utils/linearRegression");

const router = express.Router();
const upload = multer({ dest: "uploads/" });

router.post("/upload", upload.single("file"), async (req, res) => {
  const data = await processCSV(req.file.path);

  const recommendation = predictProduct(data.productSales);

  res.json({
    kpis: data.kpis,
    charts: data.charts,
    recommendation
  });
});

module.exports = router;

backend/utils/csvProcessor.js
const fs = require("fs");
const csv = require("csv-parser");

module.exports = (filePath) => {
  return new Promise((resolve) => {
    let totalRevenue = 0;
    let totalProfit = 0;
    let productSales = {};

    fs.createReadStream(filePath)
      .pipe(csv())
      .on("data", (row) => {
        const revenue = row.price * row.quantity;
        const profit = (row.price - row.cost) * row.quantity;

        totalRevenue += revenue;
        totalProfit += profit;

        productSales[row.product] =
          (productSales[row.product] || 0) + row.quantity;
      })
      .on("end", () => {
        resolve({
          kpis: {
            revenue: totalRevenue,
            profit: totalProfit
          },
          charts: productSales,
          productSales
        });
      });
  });
};
backend/utils/linearRegression.js
// Simple Linear Regression for trend prediction
function linearRegression(x, y) {
  const n = x.length;
  
  if (n === 0 || x.length !== y.length) {
    return { slope: 0, intercept: 0, r2: 0 };
  }
  
  // Calculate means
  const meanX = x.reduce((a, b) => a + b, 0) / n;
  const meanY = y.reduce((a, b) => a + b, 0) / n;
  
  // Calculate slope and intercept
  let numerator = 0;
  let denominator = 0;
  
  for (let i = 0; i < n; i++) {
    numerator += (x[i] - meanX) * (y[i] - meanY);
    denominator += (x[i] - meanX) ** 2;
  }
  
  const slope = denominator !== 0 ? numerator / denominator : 0;
  const intercept = meanY - slope * meanX;
  
  // Calculate R² (coefficient of determination)
  let ssRes = 0;
  let ssTot = 0;
  
  for (let i = 0; i < n; i++) {
    const predicted = slope * x[i] + intercept;
    ssRes += (y[i] - predicted) ** 2;
    ssTot += (y[i] - meanY) ** 2;
  }
  
  const r2 = ssTot !== 0 ? 1 - (ssRes / ssTot) : 0;
  
  return { slope, intercept, r2 };
}

// Predict next month's revenue
function predictNextMonth(monthlyTrends) {
  if (!monthlyTrends || monthlyTrends.length < 2) {
    return {
      predictedRevenue: 0,
      predictedOrders: 0,
      confidence: 0,
      trend: 'insufficient_data'
    };
  }
  
  // Create x values (0, 1, 2, ... for each month)
  const x = monthlyTrends.map((_, index) => index);
  const revenues = monthlyTrends.map(m => m.revenue);
  const orders = monthlyTrends.map(m => m.orders);
  
  // Perform linear regression
  const revenueModel = linearRegression(x, revenues);
  const ordersModel = linearRegression(x, orders);
  
  // Predict next month (x = length)
  const nextMonthIndex = monthlyTrends.length;
  const predictedRevenue = revenueModel.slope * nextMonthIndex + revenueModel.intercept;
  const predictedOrders = ordersModel.slope * nextMonthIndex + ordersModel.intercept;
  
  // Determine trend
  let trend = 'stable';
  if (revenueModel.slope > 0) {
    trend = revenueModel.slope > revenues[revenues.length - 1] * 0.05 ? 'strong_growth' : 'growth';
  } else if (revenueModel.slope < 0) {
    trend = Math.abs(revenueModel.slope) > revenues[revenues.length - 1] * 0.05 ? 'strong_decline' : 'decline';
  }
  
  return {
    predictedRevenue: Math.max(0, parseFloat(predictedRevenue.toFixed(2))),
    predictedOrders: Math.max(0, Math.round(predictedOrders)),
    confidence: parseFloat((revenueModel.r2 * 100).toFixed(2)),
    trend,
    monthlyGrowthRate: parseFloat(((revenueModel.slope / (revenues[revenues.length - 1] || 1)) * 100).toFixed(2))
  };
}

// Calculate product trend score
function calculateTrendScore(productSales) {
  if (!productSales || productSales.length < 2) {
    return {
      score: 50,
      direction: 'stable',
      momentum: 0
    };
  }
  
  // Group by month
  const monthMap = {};
  
  productSales.forEach(sale => {
    const date = new Date(sale.date);
    const monthKey = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
    
    if (!monthMap[monthKey]) {
      monthMap[monthKey] = {
        revenue: 0,
        quantity: 0
      };
    }
    
    monthMap[monthKey].revenue += sale.revenue;
    monthMap[monthKey].quantity += sale.quantity;
  });
  
  const monthlyData = Object.values(monthMap).sort((a, b) => 
    Object.keys(monthMap).indexOf(a) - Object.keys(monthMap).indexOf(b)
  );
  
  if (monthlyData.length < 2) {
    return {
      score: 50,
      direction: 'stable',
      momentum: 0
    };
  }
  
  // Calculate recent trend (last 3 months vs previous 3 months)
  const recentMonths = monthlyData.slice(-3);
  const previousMonths = monthlyData.slice(-6, -3);
  
  if (previousMonths.length === 0) {
    return {
      score: 50,
      direction: 'stable',
      momentum: 0
    };
  }
  
  const recentAvg = recentMonths.reduce((sum, m) => sum + m.revenue, 0) / recentMonths.length;
  const previousAvg = previousMonths.reduce((sum, m) => sum + m.revenue, 0) / previousMonths.length;
  
  const momentum = previousAvg > 0 ? ((recentAvg - previousAvg) / previousAvg) * 100 : 0;
  
  // Calculate score (0-100)
  let score = 50; // Base score
  score += Math.min(Math.max(momentum, -50), 50); // Add momentum (-50 to +50)
  
  let direction = 'stable';
  if (momentum > 10) direction = 'rising';
  else if (momentum > 25) direction = 'hot';
  else if (momentum < -10) direction = 'declining';
  else if (momentum < -25) direction = 'cold';
  
  return {
    score: parseFloat(Math.max(0, Math.min(100, score)).toFixed(2)),
    direction,
    momentum: parseFloat(momentum.toFixed(2))
  };
}

// Predict seasonal patterns
function detectSeasonality(monthlyTrends) {
  if (monthlyTrends.length < 12) {
    return {
      hasSeasonality: false,
      peakMonths: [],
      lowMonths: []
    };
  }
  
  // Calculate average revenue per month number (1-12)
  const monthStats = {};
  
  monthlyTrends.forEach(trend => {
    const monthNum = parseInt(trend.month.split('-')[1]);
    
    if (!monthStats[monthNum]) {
      monthStats[monthNum] = {
        total: 0,
        count: 0
      };
    }
    
    monthStats[monthNum].total += trend.revenue;
    monthStats[monthNum].count += 1;
  });
  
  const monthAverages = Object.entries(monthStats).map(([month, stats]) => ({
    month: parseInt(month),
    avgRevenue: stats.total / stats.count
  }));
  
  // Find overall average
  const overallAvg = monthAverages.reduce((sum, m) => sum + m.avgRevenue, 0) / monthAverages.length;
  
  // Find peak and low months (20% threshold)
  const peakMonths = monthAverages
    .filter(m => m.avgRevenue > overallAvg * 1.2)
    .map(m => m.month);
  
  const lowMonths = monthAverages
    .filter(m => m.avgRevenue < overallAvg * 0.8)
    .map(m => m.month);
  
  return {
    hasSeasonality: peakMonths.length > 0 || lowMonths.length > 0,
    peakMonths,
    lowMonths,
    monthAverages: monthAverages.sort((a, b) => b.avgRevenue - a.avgRevenue)
  };
}

// Calculate customer lifetime value prediction
function predictCustomerLTV(salesData) {
  const customerMap = {};
  
  salesData.forEach(sale => {
    if (!customerMap[sale.customer_id]) {
      customerMap[sale.customer_id] = {
        totalRevenue: 0,
        purchases: 0,
        firstPurchase: new Date(sale.date),
        lastPurchase: new Date(sale.date)
      };
    }
    
    const customer = customerMap[sale.customer_id];
    customer.totalRevenue += sale.revenue;
    customer.purchases += 1;
    
    const purchaseDate = new Date(sale.date);
    if (purchaseDate < customer.firstPurchase) {
      customer.firstPurchase = purchaseDate;
    }
    if (purchaseDate > customer.lastPurchase) {
      customer.lastPurchase = purchaseDate;
    }
  });
  
  const customers = Object.values(customerMap);
  
  // Calculate average metrics
  const avgRevenue = customers.reduce((sum, c) => sum + c.totalRevenue, 0) / customers.length;
  const avgPurchases = customers.reduce((sum, c) => sum + c.purchases, 0) / customers.length;
  
  // Calculate average customer lifetime in days
  const avgLifetime = customers.reduce((sum, c) => {
    const lifetime = (c.lastPurchase - c.firstPurchase) / (1000 * 60 * 60 * 24);
    return sum + lifetime;
  }, 0) / customers.length;
  
  // Predict LTV (simple model: avg revenue * estimated future purchases)
  const estimatedFuturePurchases = avgLifetime > 0 ? (365 / avgLifetime) * avgPurchases : avgPurchases;
  const predictedLTV = avgRevenue * estimatedFuturePurchases;
  
  return {
    avgCustomerValue: parseFloat(avgRevenue.toFixed(2)),
    avgPurchaseFrequency: parseFloat(avgPurchases.toFixed(2)),
    avgCustomerLifetimeDays: parseFloat(avgLifetime.toFixed(0)),
    predictedLTV: parseFloat(predictedLTV.toFixed(2))
  };
}

module.exports = {
  linearRegression,
  predictNextMonth,
  calculateTrendScore,
  detectSeasonality,
  predictCustomerLTV
};

